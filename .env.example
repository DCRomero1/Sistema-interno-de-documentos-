# Configuración del Puerto
PORT=3000

# Configuración de Sesión
SESSION_SECRET=a_very_long_and_secure_random_string

# Entorno (development / production)
NODE_ENV=production

# Seguridad Administrativa
# Cambia estas claves por unas muy seguras antes de iniciar el sistema por primera vez
MASTER_KEY=una_clave_maestra_muy_larga_y_segura
INITIAL_ADMIN_PASSWORD=una_contrasena_inicial_segura
